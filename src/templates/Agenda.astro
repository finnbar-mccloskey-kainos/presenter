---
import { getPresentation } from "../lib/presentations";

const slides = getPresentation(Astro.params.presentation)?.slides ?? [];
const sections = slides.flatMap((slide, index) =>
    slide.sectionTitle ? [{ title: slide.sectionTitle, slideNumber: index + 1 }] : [],
);
---

<div class="background">
    <div class="left">
        <h1>Agenda</h1>
    </div>
    
    <div class="right">
        <ol>
            {sections.map(({ title, slideNumber }) => (
                <li><a href={`?slide=${slideNumber}`} data-slide-number={slideNumber}>{title}</a></li>
            ))}
        </ol>
    </div>
</div>

<style>
    h1 {
        margin: 0;
    }

    .background {
        width: 100%;
        height: 100%;
        background-color: var(--white);
        color: var(--color-kainos-blue);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .left {
        height: 100%;
        flex: 1;
        color: white;
        background: linear-gradient(45deg, var(--color-kainos-blue), var(--color-kainos-green));
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .right {
        height: 100%;
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    ol {
        font-weight: bold;
    }

    li {
        padding: 1rem;
        counter-increment: li;
        list-style: none;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    a:hover, a:focus-visible {
        text-decoration: underline;
    }

    ol li::before {
        padding: 0.5rem;
        margin-right: 0.5rem;
        color: var(--color-kainos-green);
        content: counter(li) ". ";
    }
</style>
