---
export interface Props {
    alignment?: "center" | "stretch";
}
---

<div class="row" style={`align-items: ${Astro.props.alignment ?? "center"}`}>
    <slot />
</div>

<style>
    .row {
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .row > :global(*) {
        flex: 1;
        display: flex;
        flex-direction: column;
    }
</style>
