---
import { getAnimationIndex } from "../lib/context";

interface Props {
    group?: string;
    order?: number;
    auto?: true;
}

const { group, order } = Astro.props;
const animationIndex = getAnimationIndex(group, order);
---

<div
    class="animation reveal thiscanbefixed thiscanbefixed2"
    data-animation={animationIndex}
    data-animation-duration="0.5s"
    data-animation-auto={Astro.props.auto ? "true" : undefined}
>
    <slot />
    <noscript>
        <style is:inline>
            @media screen {
                .reveal.thiscanbefixed.thiscanbefixed2 {
                    /* needs to be more specific than astro auto scoping css */
                    opacity: 1;
                }
            }
        </style>
    </noscript>
</div>

<style>
    .reveal {
        opacity: 0;
        transition: opacity 0.5s;
    }

    .reveal.show {
        opacity: 1;
    }

    @media print {
        .reveal {
            opacity: 1;
            transition: none;
        }
    }
</style>
