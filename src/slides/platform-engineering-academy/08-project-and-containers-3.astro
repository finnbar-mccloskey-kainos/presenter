---
import Content from "../../templates/Content.astro";
import Overlay from "../../templates/Overlay.astro";
import Row from "../../templates/Row.astro";
import Card from "../../templates/Card.astro";
import { speakerNames } from "./config";
---

<Overlay speaker={speakerNames[1]} logo>
    <Content>
        <h2>Docker: from source to container</h2>
        <Row>
            <div><img class="img-fill" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" alt="Docker logo" /></div>
            <div>
                <Card color="var(--color-kainos-bright-blue)"><p><strong>Dockerfile</strong> → build an <strong>image</strong></p><p><strong>Registry</strong> → store and share the image</p><p><strong>Container</strong> → run an instance of the image</p></Card>
            </div>
        </Row>
    </Content>
</Overlay>
