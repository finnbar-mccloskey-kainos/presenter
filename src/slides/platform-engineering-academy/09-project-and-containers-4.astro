---
import Content from "../../templates/Content.astro";
import Overlay from "../../templates/Overlay.astro";
import Row from "../../templates/Row.astro";
import { speakerNames } from "./config";
---

<Overlay speaker={speakerNames[1]} logo>
    <Content>
        <Row>
            <div>
                <h2>Running containers in Azure</h2>
                <ul>
                    <li>Azure Container Apps can run images as managed applications.</li>
                    <li>Azure services provide networking, scaling and storage options.</li>
                    <li>Resource settings and cost monitoring help manage usage.</li>
                </ul>
                <p>Our next goal: make the website publicly available.</p>
            </div>
            <div><img class="img-fill" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/azure/azure-original.svg" alt="Microsoft Azure logo" /></div>
        </Row>
    </Content>
</Overlay>
