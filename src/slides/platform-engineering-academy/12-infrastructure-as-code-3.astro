---
import Content from "../../templates/Content.astro";
import Overlay from "../../templates/Overlay.astro";
import Row from "../../templates/Row.astro";
import Card from "../../templates/Card.astro";
import { speakerNames } from "./config";
---

<Overlay speaker={speakerNames[2]} logo>
    <Content>
        <h2>Connecting Terraform to Azure</h2>
        <Row>
            <div><Card color="var(--color-kainos-blue)"><h3>Azure provider</h3><p>Lets Terraform manage Azure resources.</p></Card></div>
            <div><Card color="var(--color-kainos-bright-blue)"><h3>Identity &amp; access</h3><p>Authentication and permissions determine what it can manage.</p></Card></div>
            <div><Card color="var(--color-kainos-green)"><h3>Plan &amp; apply</h3><p>Review proposed changes before creating or updating resources.</p></Card></div>
        </Row>
        <p>Keep credentials out of source control.</p>
    </Content>
</Overlay>
