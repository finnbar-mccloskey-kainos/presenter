---
import Content from "../../templates/Content.astro";
import Overlay from "../../templates/Overlay.astro";
import Row from "../../templates/Row.astro";
import { speakerNames } from "./config";
---

<Overlay speaker={speakerNames[2]} logo>
    <Content>
        <Row>
            <div>
                <h2>CI/CD with GitHub Actions</h2>
                <ul>
                    <li>Automated checks for all changes</li>
                    <li>
                        Ours included testing, linting, building images and
                        pushing to ACR
                    </li>
                    <li>Automated checks support fearless releases</li>
                </ul>
            </div>
            <div>
                <img
                    class="img-fill"
                    src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/githubactions/githubactions-original.svg"
                    alt="GitHub Actions logo"
                />
            </div>
        </Row>
    </Content>
</Overlay>
