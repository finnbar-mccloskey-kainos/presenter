---
import Content from "../../templates/Content.astro";
import Overlay from "../../templates/Overlay.astro";
import Row from "../../templates/Row.astro";
import Card from "../../templates/Card.astro";
import { speakerNames } from "./config";
import Reveal from "../../templates/Reveal.astro";

export const sectionTitle = "Our project";
---

<Overlay speaker={speakerNames[1]} logo>
    <Content>
        <h2>From development weeks to platforms</h2>
        <Row alignment="stretch">
            <Reveal>
                <Card color="var(--color-kainos-blue)">
                    <h3>1. Verify</h3>
                    <p>
                        Automate the tests and lint running for our E-commerce
                        site.
                    </p>
                </Card>
            </Reveal>
            <Reveal>
                <Card color="var(--color-kainos-bright-blue)">
                    <h3>2. Containerise</h3>
                    <p>Package the application as images.</p>
                </Card>
            </Reveal>
            <Reveal>
                <Card color="var(--color-kainos-green)">
                    <h3>3. Automate</h3>
                    <p>Deploy to Azure in an automated way.</p>
                </Card>
            </Reveal>
        </Row>
        <Reveal>
            <p>
                Each team member completed the academy tasks independently. one
                team member then raised and merged pull requests to prevent
                merge conflicts.
            </p>
        </Reveal>
    </Content>
</Overlay>
