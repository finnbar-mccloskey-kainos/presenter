---
import Content from "../../templates/Content.astro";
import Overlay from "../../templates/Overlay.astro";
import Row from "../../templates/Row.astro";
import Card from "../../templates/Card.astro";
import { speakerNames } from "./config";

export const sectionTitle = "Platform engineering foundations";
---

<Overlay speaker={speakerNames[0]} logo>
    <Content>
        <h2>What is platform engineering?</h2>
        <p>Building reusable tools, processes and infrastructure that enable engineering teams to serve themselves.</p>
        <Row>
            <div><Card color="var(--color-kainos-blue)"><h3>Build once</h3><p>Reusable foundations</p></Card></div>
            <div><Card color="var(--color-kainos-green)"><h3>Use often</h3><p>Self-service for teams</p></Card></div>
            <div><Card color="var(--color-kainos-bright-blue)"><h3>Improve together</h3><p>Shared ways of working</p></Card></div>
        </Row>
    </Content>
</Overlay>
