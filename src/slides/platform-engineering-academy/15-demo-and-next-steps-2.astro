---
import Content from "../../templates/Content.astro";
import Overlay from "../../templates/Overlay.astro";
import Row from "../../templates/Row.astro";
import Card from "../../templates/Card.astro";
import { speakerNames } from "./config";

export const sectionTitle = "Challenges and learning";
---

<Overlay speaker={speakerNames[3]} logo>
    <Content>
        <h2>Challenges and learning</h2>
        <Row alignment="stretch">
            <div>
                <Card color="var(--color-kainos-orange)">
                    <h3>Challenges</h3>
                    <ul>
                        <li>Limited permissions for service principals</li>
                        <li>Some bumps during Azure setup</li>
                    </ul>
                </Card>
            </div>
            <div>
                <Card color="var(--color-kainos-green)">
                    <h3>Using AI</h3>
                    <ul>
                        <li>Understand technical documentation</li>
                        <li>
                            Find starting points and model backend work on the
                            frontend
                        </li>
                        <li>Review and verify generated suggestions</li>
                    </ul>
                </Card>
            </div>
        </Row>
    </Content>
</Overlay>
