---
import Overlay from "../../templates/Overlay.astro";
import Content from "../../templates/Content.astro";
import Row from "../../templates/Row.astro";
import clientCollaboration from "./images/client-collaboration.jpg";

export const sectionTitle = "Customer-facing roots";
---
<Overlay speaker="Lee Service" logo>
    <Content>
        <h2>Start with the client problem</h2>
        <Row>
            <div>
                <img class="img-fill" src={clientCollaboration.src} alt="Illustrative photo of colleagues collaborating around laptops; not Lee Service." />
            </div>
            <div>
                <h3>Games &amp; UX</h3>
                <p>Lee's profile describes senior account management for video-game clients.</p>
                <p>The work helped clients uncover UX insights through remote playtesting.</p>
                <h3>Customer success</h3>
                <p>Customer Success Manager at Go Testify Ltd</p>
                <p>Feb 2018 – Aug 2020</p>
            </div>
        </Row>
        <p>The profile does not give dates or an employer for the senior account management work.</p>
    </Content>
</Overlay>
