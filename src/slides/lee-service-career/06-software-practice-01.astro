---
import Overlay from "../../templates/Overlay.astro";
import Content from "../../templates/Content.astro";
import Grid from "../../templates/Grid.astro";
import Card from "../../templates/Card.astro";

export const sectionTitle = "Taking the first software role";
---
<Overlay speaker="Lee Service" logo>
    <Content>
        <h2>From study into software development</h2>
        <Grid columns={2}>
            <Card color="var(--color-kainos-green)">
                <h3>Software Developer</h3>
                <p>Allstate Northern Ireland</p>
                <p>Oct 2021 – Jun 2023</p>
            </Card>
            <Card color="var(--color-kainos-blue)">
                <h3>Foundation to build on</h3>
                <ul>
                    <li>MSc completed in 2021</li>
                    <li>Profile lists experience with Java, Python, SQL, PHP, and web technologies</li>
                    <li>Nearly two years in the listed developer role</li>
                </ul>
            </Card>
        </Grid>
    </Content>
</Overlay>
