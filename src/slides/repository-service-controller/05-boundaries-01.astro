---
import Overlay from "../../templates/Overlay.astro";
import Content from "../../templates/Content.astro";
import Grid from "../../templates/Grid.astro";
import Card from "../../templates/Card.astro";

export const sectionTitle = "Set clear boundaries";
---
<Overlay speaker="Finnbar McCloskey" logo>
    <Content>
        <h2>Give each layer one reason to change</h2>
        <Grid columns={3}>
            <Card color="var(--color-kainos-blue)">
                <h3>Controller</h3>
                <p>Knows routes, HTTP status codes, and request/response formats.</p>
                <p>Does not contain business decisions or database queries.</p>
            </Card>
            <Card color="var(--color-kainos-green)">
                <h3>Service</h3>
                <p>Knows domain rules and coordinates repository calls.</p>
                <p>Does not depend on HTTP or a specific database.</p>
            </Card>
            <Card color="var(--color-kainos-grey)">
                <h3>Repository</h3>
                <p>Knows how application data is queried and stored.</p>
                <p>Does not decide whether a business action is allowed.</p>
            </Card>
        </Grid>
    </Content>
</Overlay>
