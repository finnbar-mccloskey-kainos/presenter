---
export interface Props {
	title: string;
}

const {title} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>

	@font-face {
		font-family: Century Gothic;
		font-weight: normal;
		src: url("/presenter/font/GOTHIC.TTF");
	}

	@font-face {
		font-family: Century Gothic;
		font-weight: bold;
		src: url("/presenter/font/GOTHICB.TTF");
	}

	body, html {
		font-family: Century Gothic;
		margin: 0; 
		padding: 0;
		print-color-adjust: exact;
		-webkit-print-color-adjust: exact;
	}

	:root {
		--color-kainos-blue: #283583;
		--color-kainos-green: #61a83f;
		--color-white: #ffffff;
		--color-kainos-mid-blue: #41679f;
		--color-kainos-dark-green: #004631;
		--color-kainos-grey: #575756;

		--color-kainos-orange: #ec6608;
		--color-kainos-bright-green: #cfd600;
		--color-kainos-bright-blue: #009fe3;
	}
</style>

<style is:global>

	h1 {
		font-size: 5rem;
		margin-top: 1rem;
		margin-bottom: 1rem;
	}

	h2 {
		margin-top: 0.5rem;
		margin-bottom: 0.5rem;
		font-size: 3rem;
	}

	h3 {
		margin-top: 0.5rem;
		margin-bottom: 0.5rem;
		font-size: 2rem;
	}

	p, li, .small {
		margin-top: 0.5rem;
		margin-bottom: 0.5rem;
		font-size: 1.5rem;
	}
</style>
