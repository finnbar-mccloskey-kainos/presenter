---
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import { getSlideAspectRatios, SLIDE_WIDTH } from "../lib/aspect-ratios";
import { getPresentations, type Presentation } from "../lib/presentations";

export const getStaticPaths = (() =>
    getPresentations().map((presentation) => ({
        params: { presentation: presentation.slug },
        props: { presentation },
    }))) satisfies GetStaticPaths;

const { presentation } = Astro.props as { presentation: Presentation };
const slideComponents = presentation.slides.map((slide) => slide.default);
const slideHeights = getSlideAspectRatios(presentation.slides).map((ratio) => SLIDE_WIDTH / ratio);
const printPages = slideHeights.map((height, i) =>
    `@page slide-${i} { size: ${SLIDE_WIDTH}px ${height}px; margin: 0; }`
).join("\n");
const numSlides = slideComponents.length;
---

<Layout title={presentation.title}>
<style is:global>
    :root {
        font-size: 25px;
    }
</style>
<style is:global is:inline set:html={printPages} />
<div class="slides">
    <div class="slide-background">
    {slideComponents.map((Slide, i) => (
        <div class="slide-container" id={`slide-${i}`} style={`--slide-height: ${slideHeights[i]}px; page: slide-${i};`}>
            <Slide />
        </div>
    ))}
    </div>
</div>

<script define:vars={{numSlides, slideHeights, SLIDE_WIDTH}}>
    
    function slideFromUrl() {
        const slide = Number.parseInt(new URL(location.href).searchParams.get('slide') ?? '', 10);
        return Number.isInteger(slide) && slide >= 1 && slide <= numSlides ? slide - 1 : 0;
    }

    let currentSlide = slideFromUrl();
    const slides = document.querySelectorAll('.slide-container');
    const background = document.querySelector('.slide-background');

    function resizeBackground() {
        background.style.setProperty('--background-height', `${slideHeights[currentSlide]}px`);
        background.style.setProperty('--background-scale', String(
            Math.min(window.innerWidth / SLIDE_WIDTH, window.innerHeight / slideHeights[currentSlide])
        ));
    }

    function resizeSlides() {
        slides.forEach((el, i) => {
            const scale = Math.min(window.innerWidth / SLIDE_WIDTH, window.innerHeight / slideHeights[i]);
            el.style.setProperty('--slide-scale', String(scale));
        });
        resizeBackground();
    }
    resizeSlides();
    window.addEventListener('resize', resizeSlides);
    setSlide(currentSlide);

    function setSlide(index) {
        currentSlide = index;
        resizeBackground();
        slides.forEach((el, i) => {
            el.style.opacity = i === currentSlide ? '1' : '0';
        });

        // URL uses 1-based slide numbers so permalinks read naturally.
        const url = new URL(location.href);
        url.searchParams.set('slide', String(currentSlide + 1));
        history.replaceState({ slide: currentSlide }, '', url);
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
            if (currentSlide >= numSlides - 1) return;
            setSlide((currentSlide + 1) % numSlides);
        } else if (e.key === 'ArrowLeft') {
            if (currentSlide <= 0) return;
            setSlide((currentSlide - 1 + numSlides) % numSlides);
        }
    });

</script>

<style>
    .slide-background::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        width: 1920px;
        height: var(--background-height);
        background: white;
        transform: translate(-50%, -50%) scale(var(--background-scale, 1));
    }

    .slide-container {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 1920px;
        height: var(--slide-height);
        container: slide / size;
        overflow: hidden;
        background: white;
        opacity: 0;
        transform: translate(-50%, -50%) scale(var(--slide-scale, 1));
        transition: opacity 0.5s;
    }

    .slides {
        position: relative;
        width: 100vw;
        height: 100vh;
        margin: 0;
        overflow: hidden;
        background: black;
    }

    @media print {
        @page {
            size: 1920px 1080px;
            margin: 0;
        }

        .slides {
            width: auto;
            height: auto;
        }

        .slide-background::before {
            display: none;
        }

        .slide-container {
            position: relative;
            top: 0;
            left: 0;
            opacity: 1 !important;
            transform: none;
            transition: none;
            break-after: page;
        }

        .slide-container:last-child {
            break-after: auto;
        }
    }
</style>

</Layout>
